# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Firebase
.firebase/
firebase-debug.log

# Keystore files — never commit these
*.jks
*.b64

# Test fixtures — photos of order slips. Binary, personal, and not source.
fixtures/

# Environment files — these hold real API keys. The repo is PUBLIC.
#
# `.env` is the reference sheet of every variable that must exist in a real
# environment, with the real values filled in locally. `*.local` above does NOT
# match a bare `.env`, so it is listed explicitly — without this line a key
# written there would be committed.
#
# `.env.example` is the committed template: names only, never values.
.env
.env.*
!.env.example

# Cloudflare Worker local development.
# .dev.vars is where `wrangler dev` reads GEMINI_API_KEY from, so it holds a real
# key. This repo is public; `*.local` above does not match it. See DESIGN.md §14.4.
.dev.vars
.dev.vars.*
.wrangler/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

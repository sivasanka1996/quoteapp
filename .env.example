# ============================================================================
# SECRETS TEMPLATE. Copy to .env and fill in. .env is gitignored.
# ============================================================================
#
# Everything that is NOT a secret — model names, provider, token limits, worker
# URL, allowed origins, timeouts — lives in config/app.config.ts. Do not add
# settings here; there is one place for those and this is not it.
#
# This is the committed TEMPLATE — names only, never values. Copy it:
#
#     cp .env.example .env
#
# then fill in .env, which is gitignored. .env is the reference sheet of every
# variable that must exist in a real environment, so setting up prod is reading
# down that file rather than remembering.
#
# ---------------------------------------------------------------------------
# IMPORTANT: nothing reads this file at runtime.
# ---------------------------------------------------------------------------
#
# Vite reads it when building the FRONTEND, and would compile any value into
# the public JS bundle — so a key here never reaches the Worker and would leak
# if it were prefixed VITE_. That is why none of the names below are.
#
# The values have to be copied to where each consumer actually reads them:
#
#   Cloudflare Worker, production   npx wrangler secret put <NAME>
#   Cloudflare Worker, local dev    cf-worker/.dev.vars  (also gitignored)
#   GitHub Actions                  repo Settings → Secrets and variables
#
# ============================================================================


# --- AI provider keys -------------------------------------------------------
#
# Only the key for the ACTIVE provider is needed. Which one is active is set by
# `ai.provider` in config/app.config.ts — currently "openrouter".
#
# Where: cf-worker  →  npx wrangler secret put OPENROUTER_API_KEY
# Get one at https://openrouter.ai — add a few dollars of credit; at Dad's
# volume that covers many months.
OPENROUTER_API_KEY=

# Where: cf-worker  →  npx wrangler secret put GEMINI_API_KEY
# Only needed if config/app.config.ts sets ai.provider = "gemini".
GEMINI_API_KEY=


# --- Android APK signing ----------------------------------------------------
#
# Where: GitHub → Settings → Secrets and variables → Actions
# Read by .github/workflows/build-apk.yml. Without it the next APK build fails
# with a message naming this variable.
KEYSTORE_PASSWORD=


# --- Firebase deploy --------------------------------------------------------
#
# Where: GitHub → Settings → Secrets and variables → Actions
# Read by .github/workflows/deploy.yml. Generate with: firebase login:ci
FIREBASE_TOKEN=


# --- Optional local overrides ----------------------------------------------
#
# Not secrets, and normally unnecessary — config/app.config.ts already sets
# these. Uncomment only to point a local build somewhere else, e.g. at a
# preview Worker deploy.
#
# VITE_IMAGE_PROXY_URL=https://some-other-worker.workers.dev
